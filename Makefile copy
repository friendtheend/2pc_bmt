	@echo "  run-parallel-no-pipe   Parallel without pipeline (debug)"
	@echo ""
	@echo "Benchmarking:"
	@echo "  benchmark        Compare single-channel vs multi-channel"
	@echo ""
	@echo "Variables:"
	@echo "  NUM_TRIPLES    Number of triples (default: 10000)"
	@echo "  K_BITS         Bit width: 8/16/32/64 (default: 64)"
	@echo "  NUM_CHANNELS   Parallel OT channels (default: 4)"
	@echo ""
	@echo "Examples:"
	@echo "  make all-parallel"
	@echo "  make run-parallel NUM_TRIPLES=100000000 K_BITS=32 NUM_CHANNELS=8"
	@echo "  make run-parallel-32bit NUM_TRIPLES=100000000 NUM_CHANNELS=8"
	@echo "  make benchmark NUM_TRIPLES=10000000 K_BITS=32"
	@echo ""
	@echo "Expected speedup (vs baseline 64-bit single-channel):"
	@echo "  --bits 32 --channels 1:  ~2x"
