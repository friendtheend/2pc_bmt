
# 简单的 MPI 带宽测试
cat > /tmp/mpi_bw_test.cpp << 'EOF'
#include <mpi.h>
#include <vector>
#include <chrono>
#include <cstdio>

int main(int argc, char** argv) {
    MPI_Init(&argc, &argv);
    int rank, size;
    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
    MPI_Comm_size(MPI_COMM_WORLD, &size);
    
    const size_t MSG_SIZE = 1024 * 1024;  // 1 MB
    const int ITERATIONS = 1000;
    std::vector<char> buf(MSG_SIZE);
    
    MPI_Barrier(MPI_COMM_WORLD);
    auto start = std::chrono::high_resolution_clock::now();
    
    for (int i = 0; i < ITERATIONS; i++) {
        if (rank == 0) {
            MPI_Send(buf.data(), MSG_SIZE, MPI_BYTE, 1, 0, MPI_COMM_WORLD);
            MPI_Recv(buf.data(), MSG_SIZE, MPI_BYTE, 1, 0, MPI_COMM_WORLD, MPI_STATUS_IGNORE);
        } else {
            MPI_Recv(buf.data(), MSG_SIZE, MPI_BYTE, 0, 0, MPI_COMM_WORLD, MPI_STATUS_IGNORE);
            MPI_Send(buf.data(), MSG_SIZE, MPI_BYTE, 0, 0, MPI_COMM_WORLD);
        }
    }
    
    auto end = std::chrono::high_resolution_clock::now();
    double sec = std::chrono::duration<double>(end - start).count();
    
    if (rank == 0) {
        double total_gb = (double)MSG_SIZE * ITERATIONS * 2 / 1e9;
        printf("Ping-pong: %.2f GB in %.2f s = %.2f GB/s = %.2f Gbps\n",
               total_gb, sec, total_gb/sec, total_gb/sec*8);
    }
    
    MPI_Finalize();
    return 0;
}
EOF

mpicxx -O3 /tmp/mpi_bw_test.cpp -o /tmp/mpi_bw_test

echo "=== TCP ==="
mpirun -np 2 --mca btl tcp,self /tmp/mpi_bw_test

echo "=== Vader ==="
mpirun -np 2 --mca btl vader,self /tmp/mpi_bw_test